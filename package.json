{
  "name": "tiny-game-starter",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.18",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.23",
    "expo-constants": "~57.0.18",
    "expo-dev-client": "~57.0.19",
    "expo-glass-effect": "~57.0.3",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "i18n-js": "^4.5.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "bundle": "expo export --platform ios --platform android",
    "validate:content": "jest --runInBand src/game/content/validate.test.ts",
    "puzzles:validate": "node scripts/puzzles.cjs validate",
    "puzzles:report": "node scripts/puzzles.cjs report",
    "puzzles:release-check": "node scripts/puzzles.cjs release-check",
    "puzzles:approve": "node scripts/puzzles.cjs approve",
    "puzzles:import": "node scripts/puzzles.cjs import",
    "bundle:release": "npm run puzzles:release-check && npm run bundle",
    "puzzles:record-release": "node scripts/puzzles.cjs record-release"
  },
  "private": true
}
